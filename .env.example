DATABASE_URL=postgresql+psycopg://user:password@host/database?sslmode=require
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret
TELEGRAM_ALLOWED_USER_IDS=123456789
TELEGRAM_ENFORCE_ALLOWLIST=false
REMINDER_CRON_SECRET=replace-with-another-random-secret
GEMINI_API_KEY=replace-me
GEMINI_ROUTER_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-flash-latest
APP_TIMEZONE=Asia/Ho_Chi_Minh
PENDING_ACTION_TTL_MINUTES=15
REMINDER_MAX_ATTEMPTS=5
REMINDER_LOCK_TIMEOUT_SECONDS=120
INTENT_CONFIDENCE_THRESHOLD=0.8
MAX_MESSAGE_LENGTH=4000
REMINDER_BATCH_SIZE=20
